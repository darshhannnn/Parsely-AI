# Parsely AI Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# REQUIRED CONFIGURATION
# =============================================================================

# Google Gemini API Configuration
GOOGLE_API_KEY=your_gemini_api_key_here

# LLM Provider Settings
LLM_PROVIDER=google
LLM_MODEL=gemini-1.5-pro
LLM_TEMPERATURE=0.1

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# Application Settings
APP_NAME=Parsely AI
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Database Configuration (if using)
DATABASE_URL=sqlite:///./data/parsely.db

# Cache Configuration
ENABLE_QUERY_CACHING=true
CACHE_TTL_SECONDS=3600
MAX_CONCURRENT_REQUESTS=10

# Document Processing
MAX_DOCUMENT_SIZE_MB=50
SUPPORTED_FORMATS=pdf,docx,txt,html,eml

# Security Settings
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# External Services (Optional)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=your_pinecone_environment_here

# Monitoring and Logging
ENABLE_METRICS=false
METRICS_PORT=9090
LOG_FILE_PATH=logs/parsely.log

# Development Settings
RELOAD_ON_CHANGE=false
ENABLE_CORS=true
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# =============================================================================
# CI/CD SPECIFIC VARIABLES
# =============================================================================

# GitHub Actions will set these automatically
# GITHUB_TOKEN=automatically_provided_by_github
# GITHUB_REPOSITORY=owner/repo-name
# GITHUB_REF=refs/heads/main
# GITHUB_SHA=commit_hash
# GITHUB_RUN_ID=run_id
# GITHUB_RUN_NUMBER=run_number

# Docker Registry (for releases)
DOCKER_REGISTRY=ghcr.io
DOCKER_USERNAME=your_github_username
# DOCKER_PASSWORD=your_github_token (set as secret)

# Deployment Settings
ENVIRONMENT=development
DEPLOYMENT_URL=https://your-app-url.com